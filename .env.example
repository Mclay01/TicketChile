# M7: server-side AI configuration only. Disabled unless deliberately configured.
AI_PROVIDER=disabled
# For an isolated development environment: AI_PROVIDER=development
# For a real adapter: AI_PROVIDER=openai, an approved Structured Outputs model,
# the same exact identifier in AI_ALLOWED_MODELS, and a server-only API key.
OPENAI_API_KEY=
AI_MODEL=
AI_ALLOWED_MODELS=
AI_FEATURES=event,title,description,shorten,summary,faq,seo,tiers,readiness,analytics,promotion,communication
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=2500
AI_TIMEOUT_MS=20000
AI_PUBLIC_HOURLY_LIMIT=5
AI_USER_HOURLY_LIMIT=30
AI_GLOBAL_HOURLY_LIMIT=200
# Existing M3 SECURITY_DATA_KEY must be securely configured for encryption/rates.
# SECURITY_TRUSTED_IP_HEADER is allowed only when ingress overwrites the header.
