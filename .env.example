# TicketChile M10 configuration inventory. ALL values intentionally empty.
# Copy only required keys to the deployment secret manager. Never commit filled files.
# See docs/03-implementation/ENVIRONMENT.md for conditions, defaults and aliases.

# APP
APP_BASE_URL=
NEXTAUTH_URL=
NEXTAUTH_URL_INTERNAL=
SUPPORT_EMAIL=
APP_URL=
NEXT_PUBLIC_APP_URL=

# DATABASE (choose the preferred URL; aliases retained for compatibility)
TICKETCHILE_DB_POSTGRES_URL=
TICKETCHILE_DB_POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=
MIGRATION_DATABASE_URL=

# AUTH
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EMAIL
MAIL_TRANSPORT=
RESEND_API_KEY=
FROM_EMAIL=

# PAYMENTS
CHECKOUT_FEE_POLICY=
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REFUNDS_ENABLED=
WEBPAY_ENABLED=
WEBPAY_ENV=
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
FLOW_ENABLED=
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=

# AI
AI_PROVIDER=
OPENAI_API_KEY=
AI_MODEL=
AI_ALLOWED_MODELS=
AI_FEATURES=
AI_MAX_INPUT_CHARS=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
AI_PUBLIC_HOURLY_LIMIT=
AI_USER_HOURLY_LIMIT=
AI_GLOBAL_HOURLY_LIMIT=
ORGANIZER_AI_ADAPTER=

# MEDIA (server-only; bucket must start ticketchile-<environment>-)
MEDIA_PROVIDER=
APP_ENVIRONMENT=
MEDIA_ENVIRONMENT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_MAX_BYTES=
MEDIA_MAX_PENDING=
MEDIA_GRACE_HOURS=
MEDIA_PROCESSING_CONCURRENCY=

# WALLET
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# SECURITY
SECURITY_DATA_KEY=
SECURITY_TRUSTED_IP_HEADER=
TICKETCHILE_QR_SECRET=

# WORKERS (scheduler configuration belongs to the chosen runtime; none installed)
# Existing worker services use the DATABASE, EMAIL and PAYMENTS settings above.

# OBSERVABILITY / BUILD (hosting supplies NODE_ENV and optionally VERCEL_URL)
NEXT_TELEMETRY_DISABLED=
TICKETCHILE_BUILD_DIR=
