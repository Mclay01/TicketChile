{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:in-process": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "test:security": "node --test --experimental-test-isolation=none tests/security.integration.test.mjs",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:migrate:local": "node scripts/migrate.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:all": "node scripts/lint-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "next-auth": "^4.24.15",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.7.0",
    "sharp": "0.35.4",
    "stripe": "^20.1.0",
    "transbank-sdk": "^6.1.1"
  },
  "pnpm": {
    "overrides": {
      "qs@6": "6.16.0",
      "axios@1": "1.20.0",
