    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
