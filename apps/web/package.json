      "form-data@4": "4.0.6",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.9",
      "ajv@6": "6.14.0",
      "flatted@3": "3.4.4",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.7",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.7",
      "js-yaml@4": "4.3.2",
      "@babel/core@7": "7.29.7",
      "browserslist@4": "4.29.2",
      "@humanfs/node@0.16": "0.16.8"
    }
